{
  "name": "deepseek-harness-t3-sidebar",
  "version": "0.1.0",
  "description": "T3 Code's thread sidebar, rebuilt as a client plugin for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "files": [
    "lib/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/",
    "probe": "node scripts/probe-projection.mjs"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.64.1"
  }
}
