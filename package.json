{
  "name": "deepseek-harness-t3-sidebar",
  "version": "0.1.0",
  "description": "T3 Code's thread sidebar, rebuilt as a client plugin for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/check-boundaries.ts && node --test tests/ && vitest run",
    "probe": "node scripts/probe-projection.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.27.0",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
