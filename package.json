{
  "name": "deepseek-harness-t3-sidebar",
  "version": "0.1.0",
  "description": "T3 Code's thread sidebar, rebuilt as a client plugin for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/**",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
